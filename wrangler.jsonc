{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "consultway-ops",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-04-01",
  // `nodejs_compat` — enables Node-compat layer (Buffer, process, etc.)
  // `nodejs_als`    — Async Local Storage support, required by Next 16's
  //                   request-scoped context (cookies(), headers(),
  //                   draftMode(), and React Server Components rely on
  //                   ALS for per-request state). Without this, RSC page
  //                   renders fail with "Could not find module root"
  //                   from module-resolution code in the worker.
  "compatibility_flags": ["nodejs_compat", "nodejs_als"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "placement": {
    "mode": "smart"
  },

  // ── D1 (SQLite) ─────────────────────────────────────
  // Create with: wrangler d1 create consultway-prod
  // Then replace database_id with the UUID that command prints.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "consultway-prod",
      "database_id": "REPLACE_WITH_D1_UUID",
      "migrations_dir": "drizzle"
    }
  ],

  // ── R2 (object storage) ─────────────────────────────
  // Create with: wrangler r2 bucket create consultway-docs
  "r2_buckets": [
    {
      "binding": "DOCS",
      "bucket_name": "consultway-docs"
    }
  ],

  // ── KV (sessions, rate limiting) ────────────────────
  // Create with: wrangler kv namespace create SESSIONS
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "39fe6941eb4d4c95ba573ce0ca7e78fe"
    },
    {
      "binding": "RATE_LIMITS",
      "id": "ac1632c58c164616a78a36b8f786c083"
    }
  ],

  // ── Scheduled triggers (cron) ───────────────────────
  // Dispatched by `lib/crons/scheduled-handler.ts::scheduled()` once the
  // OpenNext worker entry re-exports it (Day 13 follow-up — see
  // docs/reports/day-13-report.md).
  "triggers": {
    "crons": [
      "0 2 * * *", // 2 AM UTC daily — document expiry sweep
      "0 3 * * *", // 3 AM UTC daily — pending-upload row cleanup
      "0 4 * * *"  // 4 AM UTC daily — expired-token cleanup (verification + reset)
    ]
  },

  // ── Public vars (non-secret) ────────────────────────
  // Secrets (RESEND_API_KEY, JWT_SECRET, etc.) are NOT here — set via
  //   wrangler secret put RESEND_API_KEY --env <environment>
  // See docs/09-deployment.md § "Resend setup" for the email provider
  // configuration steps.
  "vars": {
    "NODE_ENV": "production",
    "NEXT_PUBLIC_APP_NAME": "Consultway Ops",
    "LOG_LEVEL": "info",
    "R2_MAX_UPLOAD_BYTES": "20971520",
    "R2_PRESIGN_EXPIRY": "900",
    "RATE_LIMIT_PUBLIC_RPM": "20",
    "RATE_LIMIT_AUTH_RPM": "120",
    // Outbound sender identity for transactional email. Placeholder
    // values stay on the unroutable `.local` TLD so a misconfigured
    // dev/preview env can't accidentally send from a real domain.
    // Per-environment overrides below replace these in staging/prod.
    "EMAIL_FROM": "Consultway <noreply@consultway.local>",
    "EMAIL_REPLY_TO": ""
  },

  // ── Environments ────────────────────────────────────
  // Secrets (PAYLOAD_SECRET, JWT_SECRET, RESEND_API_KEY, etc.) are set via:
  //   wrangler secret put <NAME> --env staging
  //   wrangler secret put <NAME> --env production
  "env": {
    "staging": {
      "name": "consultway-ops-staging",
      // Wrangler does NOT inherit top-level `vars` / `kv_namespaces`
      // into environment blocks (every other binding type IS env-
      // scoped automatically). The full set is duplicated here so
      // the staging worker actually sees them at runtime. Keep this
      // block synchronised with the top-level `vars` whenever a new
      // var lands; staging-specific overrides go last.
      "vars": {
        "NODE_ENV": "production",
        "NEXT_PUBLIC_APP_NAME": "Consultway Ops",
        "LOG_LEVEL": "info",
        "R2_MAX_UPLOAD_BYTES": "20971520",
        "R2_PRESIGN_EXPIRY": "900",
        "RATE_LIMIT_PUBLIC_RPM": "20",
        "RATE_LIMIT_AUTH_RPM": "120",
        // ── staging-specific overrides ─────────────────────
        "NEXT_PUBLIC_APP_URL": "https://staging.ops.consultway.info",
        // Real sender for staging — once consultway.info (or a sub-
        // domain) is verified in Resend, swap to the verified address.
        // Until then, log-fallback in lib/email/client.ts kicks in
        // because RESEND_API_KEY (a secret, set via `wrangler secret
        // put`) won't be present on first deploy.
        "EMAIL_FROM": "Consultway Staging <noreply@staging.ops.consultway.info>",
        "EMAIL_REPLY_TO": "support@consultway.info"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "consultway-staging",
          "database_id": "901b2201-f65b-4e75-a2dd-3634a15ba197",
          "migrations_dir": "drizzle"
        }
      ],
      "r2_buckets": [
        { "binding": "DOCS", "bucket_name": "consultway-docs-staging" }
      ],
      // Same non-inheritance gotcha as `vars` — KV namespaces from the
      // top level don't reach environment blocks. The IDs here are the
      // SAME ones declared at the top level (we use a single set of
      // namespaces across environments today; if a future split is
      // needed we'd create staging-specific namespaces and swap the ids).
      "kv_namespaces": [
        {
          "binding": "SESSIONS",
          "id": "39fe6941eb4d4c95ba573ce0ca7e78fe"
        },
        {
          "binding": "RATE_LIMITS",
          "id": "ac1632c58c164616a78a36b8f786c083"
        }
      ],
      // ── Service bindings ────────────────────────────────
      // PDF rendering is offloaded to the sibling consultway-ops-pdf
      // worker (workers/pdf/) — @react-pdf/renderer is too big to fit
      // in this worker's bundle alongside Next. lib/reports/pdf.tsx
      // POSTs the report payload to env.PDF_WORKER over this binding.
      // The target worker must be deployed FIRST (it has no public URL;
      // see docs/DEPLOY_PDF_WORKER.md). Service bindings, like vars/kv,
      // do NOT inherit from the top level into env blocks.
      "services": [
        {
          "binding": "PDF_WORKER",
          "service": "consultway-ops-pdf-staging"
        }
      ]
    },
    "production": {
      "name": "consultway-ops",
      "route": {
        "pattern": "ops.consultway.info/*",
        "zone_name": "consultway.info"
      },
      // Same duplication pattern as staging — see comment there.
      "vars": {
        "NODE_ENV": "production",
        "NEXT_PUBLIC_APP_NAME": "Consultway Ops",
        "LOG_LEVEL": "info",
        "R2_MAX_UPLOAD_BYTES": "20971520",
        "R2_PRESIGN_EXPIRY": "900",
        "RATE_LIMIT_PUBLIC_RPM": "20",
        "RATE_LIMIT_AUTH_RPM": "120",
        // ── production-specific overrides ──────────────────
        "NEXT_PUBLIC_APP_URL": "https://ops.consultway.info",
        // Production sender. Domain must be verified in Resend (SPF +
        // DKIM records on consultway.info) before sends will land —
        // see docs/09-deployment.md § "Resend setup".
        "EMAIL_FROM": "Consultway <noreply@ops.consultway.info>",
        "EMAIL_REPLY_TO": "support@consultway.info"
      },
      "kv_namespaces": [
        {
          "binding": "SESSIONS",
          "id": "39fe6941eb4d4c95ba573ce0ca7e78fe"
        },
        {
          "binding": "RATE_LIMITS",
          "id": "ac1632c58c164616a78a36b8f786c083"
        }
      ],
      // ── Service bindings ────────────────────────────────
      // Production PDF worker. Points at consultway-ops-pdf (the prod
      // name in workers/pdf/wrangler.jsonc). Like staging, deploy the
      // PDF worker before promoting this worker to prod. See
      // docs/DEPLOY_PDF_WORKER.md.
      "services": [
        {
          "binding": "PDF_WORKER",
          "service": "consultway-ops-pdf"
        }
      ]
    }
  }
}
