{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://localhost:3000",
          "https://*.workers.dev",
          "https://staging.ops.consultway.info",
          "https://ops.consultway.info"
        ],
        "methods": ["GET", "PUT"],
        "headers": ["Content-Type"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
