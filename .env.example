# ───────────────────────────────────────────────────────────────────
# Consultway Ops — environment variables
#
# Copy to .env.local for development. Never commit .env.local.
# Production/staging secrets live in Cloudflare (see docs/09-deployment.md).
#
# Every var listed here is read by lib/env.ts via a Zod schema. If you
# add a new one:
#   1. Add it below with a placeholder
#   2. Add it to the schema in lib/env.ts
#   3. Set it in Cloudflare secrets before deploying
# ───────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Consultway Ops"

# ── Secrets ───────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 32
# Dev has safe defaults in lib/env.ts — these overrides are optional
# locally but REQUIRED in staging/prod.

# Signs session JWTs. Rotating invalidates all active sessions.
JWT_SECRET=replace-me-generate-with-openssl

# Added to every password before bcrypt hashing. Rotating INVALIDATES
# ALL PASSWORDS IN THE DATABASE — treat this as a stable secret.
PASSWORD_PEPPER=replace-me-generate-with-openssl

# ── Database ──────────────────────────────────────────────────────
# Local dev path to the SQLite file. In production, the D1 binding
# comes from wrangler.jsonc — this var is unused in Workers runtime.
DATABASE_URL=./.wrangler/consultway-local.sqlite

# ── Observability ─────────────────────────────────────────────────
# Accepted: debug | info | warn | error
LOG_LEVEL=info

# ── Email (Resend) ────────────────────────────────────────────────
# Transactional email via Resend. Used by the document expiry-reminder
# cron (Day 10) and future verification / password-reset flows.
#
# RESEND_API_KEY is OPTIONAL in dev: when unset, lib/email/client.ts
# falls back to logging the rendered payload instead of sending. That
# lets contributors run `pnpm cron:expiry-sweep` locally without
# provisioning a Resend account. Production MUST set a real value.
#
# Get a key: https://resend.com/api-keys (free tier covers Phase 1
# volume comfortably).
RESEND_API_KEY=
EMAIL_FROM="Consultway <noreply@consultway.local>"
# EMAIL_REPLY_TO=support@consultway.local

# ── Rate limiting — added in a later chunk ────────────────────────
# RATE_LIMIT_PUBLIC_RPM=20
# RATE_LIMIT_AUTH_RPM=120

# ── Cron — added in a later chunk ─────────────────────────────────
# CRON_SECRET=replace-me-generate-with-openssl

# ── Dev conveniences ──────────────────────────────────────────────
# Set to "1" to bypass email verification locally.
DEV_SKIP_EMAIL_VERIFY=0
# ── R2 (object storage for documents) ─────────────────────────────
# Cloudflare R2 holds document file bytes. The app talks to R2 via
# sigv4-signed HTTPS requests, NOT the Workers R2 binding. That keeps
# the dev-loop simple (no wrangler needed for normal dev) and matches
# how production direct-upload flows will work.
#
# Setup (one-time, see docs/09-deployment.md for the full version):
#   1. wrangler r2 bucket create consultway-docs
#   2. Cloudflare dashboard -> R2 -> Manage R2 API Tokens
#   3. Create Account API Token: "Object Read & Write", scoped to
#      consultway-docs, TTL Forever
#   4. Copy the four values below into .env.local
#
# lib/env.ts has placeholder defaults so `pnpm dev` boots without these
# set. Anything that actually CALLS R2 will fail with SignatureDoesNotMatch
# until real values are wired in - that's the desired loud-failure mode.

# Cloudflare account ID. Visible top-right in the dashboard, also
# embedded in the R2 S3 endpoint URL.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id

# R2 API token credentials (Account API Token, Object Read & Write).
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key

# Bucket name. Same value for dev and prod - separation is at the
# account level.
R2_BUCKET_NAME=consultway-docs

